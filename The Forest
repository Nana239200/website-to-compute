                Item("جرعة صحية صغيرة", ItemType.POTION, 5, "تعيد 30 نقطة حياة", {"شفاء": 30})
            ],
            CharacterClass.MAGE: [
                Item("عصا سحرية", ItemType.WEAPON, 10, "عصا للمبتدئين في السحر", {"هجوم": 3, "سحر": 5}),
                Item("جرعة سحرية صغيرة", ItemType.POTION, 5, "تعيد 20 نقطة سحر", {"استعادة سحر": 20}),
                Item("جرعة صحية صغيرة", ItemType.POTION, 5, "تعيد 30 نقطة حياة", {"شفاء": 30})
            ],
            CharacterClass.ARCHER: [
                Item("قوس مبتدئ", ItemType.WEAPON, 10, "قوس للرماة المبتدئين", {"هجوم": 4}),
                Item("جرعة صحية صغيرة", ItemType.POTION, 5, "تعيد 30 نقطة حياة", {"شفاء": 30}),
