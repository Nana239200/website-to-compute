class Quest:
    def __init__(self, id, title, description, objectives, rewards):
        self.id = id
        self.title = title
        self.description = description
        self.objectives = objectives  # {objective_type: target_count}
        self.rewards = rewards  # {exp: amount, gold: amount, items: [items]}
        self.progress = {obj: 0 for obj in objectives}
        self.completed = False
    
    def update_progress(self, objective_type, amount=1):
        if objective_type in self.progress:
            self.progress[objective_type] += amount
            self.check_completion()
    
    def check_completion(self):
        for obj, target in self.objectives.items():
            if self.progress[obj] < target:
                return False
        self.completed = True
        return True
    
    def status(self):
        status_text = f"\nالمهمة: {self.title}\n{self.description}\n"
        for obj, target in self.objectives.items():
            progress = self.progress[obj]
            status_text += f"  - {obj}: {progress}/{target}\n"
        
        if self.completed:
            status_text += "\n✓ المهمة مكتملة! اذهب للحصول على مكافأتك.\n"
        
        return status_text

