    def enemy_attack(self, enemy):
        damage = max(1, enemy.attack - self.player.defense // 2)
        self.player.hp -= damage
        print(f"{enemy.name} هاجمك وتسبب في {damage} ضرر!")

    def victory(self, enemy):
        print(f"\n🎉 لقد هزمت {enemy.name}!")
        
        # المكافآت
        self.player.add_exp(enemy.exp_reward)
        self.player.gold += enemy.gold_reward
        self.player.kill_count += 1
        
        print(f"كسبت {enemy.exp_reward} خبرة و {enemy.gold_reward} ذهب!")
        
        # المسروقات
        if enemy.loot:
            self.player.inventory.append(enemy.loot)
            print(f"حصلت على {enemy.loot.name}!")
        
        # التحقق من المهام
        self.check_quest_completion()

    def update_quest_progress(self, objective_type):
        for quest in self.player.quests:
            for obj in quest.objectives:
                if obj in objective_type:
                    quest.update_progress(obj)
                    break

    def check_quest_completion(self):
        for quest in self.player.quests[:]:
            if quest.completed and quest not in self.player.completed_quests:
                print(f"\n✨ أكملت المهمة: {quest.title}!")
                
                # منح المكافآت
                self.player.add_exp(quest.rewards["exp"])
                self.player.gold += quest.rewards["gold"]
                
                print(f"كسبت {quest.rewards['exp']} خبرة و {quest.rewards['gold']} ذهب!")
                
                # منح العناصر
                for item_name in quest.rewards.get("items", []):
                    # البحث عن العنصر في المتجر أو إنشاؤه
                    for shop_item in self.shop_items:
                        if shop_item.name == item_name:
                            self.player.inventory.append(shop_item)
                            print(f"حصلت على {item_name}!")
                            break
                
                self.player.completed_quests.append(quest)
                self.player.quests.remove(quest)

    def shop(self):
        print("\n╔══════════════════════════════════════════╗")
        print("║                المتجر                     ║")
        print("║        مرحباً! ماذا تريد؟                ║")
        print("╚══════════════════════════════════════════╝")
        
        print(f"\nذهبك: {self.player.gold}")
        print("\nالبضائع المتاحة:")
        
        for i, item in enumerate(self.shop_items, 1):
            print(f"{i}. {item.name:25} - {item.value:3d} ذهب")
            print(f"   {item.description}")
        
        print("\nالأوامر:")
        print("شراء <رقم> - شراء عنصر")
        print("بيع - عرض العناصر للبيع")
        print("خروج - مغادرة المتجر")
        
        while True:
            command = input("\n> ").strip().lower()
            
            if command.startswith("شراء"):
                try:
                    item_num = int(command.split()[1]) - 1
