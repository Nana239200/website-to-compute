    def travel(self):
        current_area = self.areas[self.player.location]
        
        if not current_area["connections"]:
            print("لا يمكنك الانتقال من هذه المنطقة!")
            return
        
        print("\nيمكنك الانتقال إلى:")
        for i, area in enumerate(current_area["connections"], 1):
            print(f"{i}. {area}")
        
        try:
            choice = int(input("\اختر رقم المنطقة: ")) - 1
            if 0 <= choice < len(current_area["connections"]):
                new_location = current_area["connections"][choice]
                self.player.location = new_location
                print(f"لقد انتقلت إلى {new_location}")
            else:
                print("اختيار غير صحيح!")
        except ValueError:
            print("الرجاء إدخال رقم صحيح!")

    def explore(self):
        current_area = self.areas[self.player.location]
        
        if current_area["enemies"]:
            print("تقوم باستكشاف المنطقة...")
            time.sleep(1)
            
            if random.random() < 0.6:  # 60% فرصة لمقابلة عدو
                enemy_type = random.choice(current_area["enemies"])
                enemy_info = self.enemy_types[enemy_type]
                enemy_level = random.randint(enemy_info["min_level"], enemy_info["max_level"])
                enemy = Enemy(enemy_type, enemy_level, self.player.location)
                
                print(f"\n⚠ لقد صادفت {enemy.name} (مستوى {enemy.level})!")
                print(enemy.status())
                
                choice = input("هل تريد المحاربة؟ (نعم/لا): ").lower()
                if choice in ["نعم", "ن", "y", "yes"]:
                    self.combat(enemy)
                else:
                    if random.random() < 0.3:  # 30% فرصة للهروب الفاشل
                        print("فشلت في الهروب! يهاجمك العدو!")
                        self.combat(enemy)
                    else:
                        print("لقد هربت بنجاح!")
            else:
                # اكتشاف عنصر أو ذهب
                discoveries = [
                    ("عثرت على صندوق كنز!", random.randint(10, 50), None),
                    ("وجدت جرعة صحية على الأرض!", 0, Item("جرعة صحية صغيرة", ItemType.POTION, 5, "تعيد 30 نقطة حياة", {"شفاء": 30})),
                    ("لاحظت كيس ذهب ملقى!", random.randint(5, 20), None),
                    ("وجدت سيفاً قديماً!", 0, Item("سيف صدئ", ItemType.WEAPON, 15, "سيف قديم لكنه مفيد", {"هجوم": 4}))
                ]
                
                discovery = random.choice(discoveries)
                print(f"\n✨ {discovery[0]}")
                
                if discovery[1] > 0:
                    self.player.gold += discovery[1]
                    print(f"لقد حصلت على {discovery[1]} ذهب!")
                
                if discovery[2]:
                    self.player.inventory.append(discovery[2])
                    print(f"لقد حصلت على {discovery[2].name}!")
        else:
            print("هذه منطقة آمنة. لا يوجد ما تستكشفه هنا.")

