    def craft_item(self, recipe):
        # التحقق من المواد
        for material, amount_needed in recipe["materials"]:
            amount_has = sum(1 for item in self.player.inventory if item.name == material)
            
            if amount_has < amount_needed:
                print(f"تحتاج إلى {amount_needed} من {material}، لديك فقط {amount_has}!")
                return
        
        # إزالة المواد
        for material, amount_needed in recipe["materials"]:
            removed = 0
            for i in range(len(self.player.inventory) - 1, -1, -1):
                if removed >= amount_needed:
                    break
                if self.player.inventory[i].name == material:
                    self.player.inventory.pop(i)
                    removed += 1
        
        # إضافة الناتج
        self.player.inventory.append(recipe["result"])
        print(f"صنعت {recipe['result'].name} بنجاح!")

