                Item("جرعة صحية صغيرة", ItemType.POTION, 5, "تعيد 30 نقطة حياة", {"شفاء": 30})
            ]
        }
        
        self.inventory.extend(starting_items[self.character_class])
        self.equip_item(starting_items[self.character_class][0].name)
        if self.character_class == CharacterClass.WARRIOR:
            self.equip_item(starting_items[self.character_class][1].name)
    
    def equip_item(self, item_name):
        for item in self.inventory:
            if item.name == item_name and item.type in [ItemType.WEAPON, ItemType.ARMOR]:
                if item.type == ItemType.WEAPON:
                    self.equipped["سلاح"] = item
                elif item.type == ItemType.ARMOR:
                    self.equipped["درع"] = item
                return f"لقد جهزت {item.name}"
        return "لم أجد هذا العنصر في المخزن"
    
    def use_item(self, item_name):
        for i, item in enumerate(self.inventory):
            if item.name == item_name:
                if item.type == ItemType.POTION:
                    if "شفاء" in item.stats:
                        heal_amount = min(item.stats["شفاء"], self.max_hp - self.hp)
                        self.hp += heal_amount
                        self.inventory.pop(i)
                        return f"استخدمت {item.name} واستعديت {heal_amount} نقطة حياة"
                    elif "استعادة سحر" in item.stats:
                        mp_amount = min(item.stats["استعادة سحر"], self.max_mp - self.mp)
                        self.mp += mp_amount
                        self.inventory.pop(i)
                        return f"استخدمت {item.name} واستعديت {mp_amount} نقطة سحر"
                elif item.type == ItemType.KEY:
                    self.inventory.pop(i)
                    return f"استخدمت {item.name}"
        return "لا يمكن استخدام هذا العنصر"
    
    def add_exp(self, amount):
        self.exp += amount
        while self.exp >= self.exp_to_next:
            self.level_up()
    
    def level_up(self):
        self.level += 1
        self.exp -= self.exp_to_next
        self.exp_to_next = int(self.exp_to_next * 1.5)
        
        old_max_hp = self.max_hp
        old_max_mp = self.max_mp
        
        self.max_hp = self.calculate_max_hp()
        self.max_mp = self.calculate_max_mp()
        self.hp = self.max_hp
        self.mp = self.max_mp
        
        return f"""
        ╔══════════════════════╗
        ║    لقد ارتقيت مستوى!   ║
        ║    المستوى: {self.level:2d}            ║
        ║                      ║
        ║  ✓ الحياة: {old_max_hp:3d} → {self.max_hp:3d}  ║
        ║  ✓ السحر:  {old_max_mp:3d} → {self.max_mp:3d}  ║
        ╚══════════════════════╝
        """
    
    def status(self):
        hp_bar = "█" * int((self.hp / self.max_hp) * 20) + "░" * (20 - int((self.hp / self.max_hp) * 20))
        mp_bar = "█" * int((self.mp / self.max_mp) * 20) + "░" * (20 - int((self.mp / self.max_mp) * 20))
        exp_percent = (self.exp / self.exp_to_next) * 100
        
        return f"""
╔══════════════════════════════════════════╗
║            حالة {self.name:^20}          ║
╠══════════════════════════════════════════╣
║ المستوى: {self.level:3d}    {self.character_class.value:^15}    ║
║ الخبرة:  {self.exp:4d}/{self.exp_to_next:4d} ({exp_percent:.1f}%)     ║
║                                          ║
║ الحياة: {hp_bar} {self.hp:3d}/{self.max_hp:3d} ║
║ السحر:  {mp_bar} {self.mp:3d}/{self.max_mp:3d} ║
║                                          ║
║ الهجوم:  {self.attack:3d}       الدفاع: {self.defense:3d}    ║
║ الذهب:   {self.gold:5d}       المقتولين: {self.kill_count:3d} ║
║ الموقع:  {self.location:^20}      ║
╚══════════════════════════════════════════╝
        """

