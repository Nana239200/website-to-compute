                        else:
                            print("ليس لديك ذهب كافٍ!")
                    else:
                        print("رقم العنصر غير صحيح!")
                except (ValueError, IndexError):
                    print("استخدم: شراء <رقم>")
            
            elif command == "بيع":
                self.sell_items()
            
            elif command == "خروج":
                print("شكراً لزيارتك!")
                break
            
            else:
                print("أمر غير معروف!")

    def sell_items(self):
        if not self.player.inventory:
            print("ليس لديك عناصر للبيع!")
            return
        
        print("\nعناصر يمكن بيعها:")
        for i, item in enumerate(self.player.inventory, 1):
            sell_price = max(1, item.value // 2)
            print(f"{i}. {item.name:25} - {sell_price:3d} ذهب")
        
        try:
            choice = input("\nاختر رقم العنصر للبيع (أو 'الكل' لبيع الكل): ")
            
            if choice == "الكل":
                total_gold = 0
                for item in self.player.inventory[:]:
                    sell_price = max(1, item.value // 2)
                    total_gold += sell_price
                
                self.player.gold += total_gold
                self.player.inventory.clear()
                print(f"بعت جميع العناصر بـ {total_gold} ذهب!")
            
            else:
                item_num = int(choice) - 1
                if 0 <= item_num < len(self.player.inventory):
                    item = self.player.inventory[item_num]
                    sell_price = max(1, item.value // 2)
                    
                    self.player.gold += sell_price
                    self.player.inventory.pop(item_num)
                    
                    print(f"بعت {item.name} بـ {sell_price} ذهب!")
                else:
                    print("رقم العنصر غير صحيح!")
        
        except ValueError:
            print("الرجاء إدخال رقم صحيح!")

