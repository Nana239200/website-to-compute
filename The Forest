    def combat(self, enemy):
        print("\n" + "="*50)
        print(f"معركة ضد {enemy.name}!")
        print("="*50)
        
        while enemy.hp > 0 and self.player.hp > 0:
            print("\n" + enemy.status())
            print(self.player.status())
            
            print("\nاختر إجراء:")
            print("1. هجوم عادي")
            print("2. هجوم خاص (يتطلب سحراً)")
            print("3. استخدام جرعة")
            print("4. محاولة الهرب")
            
            try:
                action = input("\nاختر رقم الإجراء: ")
                
                if action == "1":
                    self.normal_attack(enemy)
                elif action == "2":
                    self.special_attack(enemy)
                elif action == "3":
                    self.use_potion_in_combat()
                elif action == "4":
                    if random.random() < 0.5:
                        print("لقد هربت بنجاح!")
                        return
                    else:
                        print("فشلت في الهروب!")
                else:
                    print("اختيار غير صحيح!")
                    continue
                
                # هجوم العدو إذا كان لا يزال حياً
                if enemy.hp > 0:
                    self.enemy_attack(enemy)
            
            except ValueError:
                print("الرجاء إدخال رقم صحيح!")
        
        if self.player.hp <= 0:
            print("\n╔══════════════════════════════════════════╗")
            print("║            لقد هزمت!                     ║")
            print("║       ستعود إلى القرية                   ║")
            print("╚══════════════════════════════════════════╝")
            self.player.hp = self.player.max_hp // 2
            self.player.location = "القرية"
            self.player.gold = max(0, self.player.gold - 20)  # خسارة بعض الذهب
        else:
            self.victory(enemy)

    def normal_attack(self, enemy):
        damage = max(1, self.player.attack - enemy.defense // 2)
        enemy.hp -= damage
        print(f"هاجمت {enemy.name} وتسببت في {damage} ضرر!")
        
        # تحديث المهام
        self.update_quest_progress(f"قتل {enemy.name.split()[0]}")

    def special_attack(self, enemy):
        special_cost = 15
        
        if self.player.mp < special_cost:
            print("ليس لديك سحر كافٍ!")
            return
        
        self.player.mp -= special_cost
        
        damage_multiplier = {
            CharacterClass.WARRIOR: 2.0,
            CharacterClass.MAGE: 2.5,
            CharacterClass.ARCHER: 1.8,
            CharacterClass.ROGUE: 2.2
        }
        
        damage = max(1, int(self.player.attack * damage_multiplier[self.player.character_class] - enemy.defense // 2))
        enemy.hp -= damage
        
        attack_names = {
            CharacterClass.WARRIOR: "ضربة ساحقة",
            CharacterClass.MAGE: "كرة نار",
            CharacterClass.ARCHER: "سهم نافذ",
            CharacterClass.ROGUE: "طعنة خفية"
        }
        
        print(f"استخدمت {attack_names[self.player.character_class]} على {enemy.name} وتسببت في {damage} ضرر!")

    def use_potion_in_combat(self):
        usable_items = [item for item in self.player.inventory 
                       if item.type == ItemType.POTION]
        
        if not usable_items:
            print("لا تملك جرعات!")
            return
        
        print("\nاختر جرعة للاستخدام:")
        for i, item in enumerate(usable_items, 1):
            effect = list(item.stats.keys())[0]
            value = list(item.stats.values())[0]
            print(f"{i}. {item.name} - {effect} {value}")
        
        try:
            choice = int(input("\nاختر رقم الجرعة: ")) - 1
            if 0 <= choice < len(usable_items):
                result = self.player.use_item(usable_items[choice].name)
