    def save_game(self):
        save_data = {
            "player": {
                "name": self.player.name,
                "character_class": self.player.character_class.value,
                "level": self.player.level,
                "exp": self.player.exp,
                "exp_to_next": self.player.exp_to_next,
                "hp": self.player.hp,
                "max_hp": self.player.max_hp,
                "mp": self.player.mp,
                "max_mp": self.player.max_mp,
                "gold": self.player.gold,
                "location": self.player.location,
                "kill_count": self.player.kill_count,
                "inventory": [
                    {
                        "name": item.name,
                        "type": item.type.value,
                        "value": item.value,
                        "description": item.description,
                        "stats": item.stats
                    }
                    for item in self.player.inventory
                ],
                "equipped": {
                    slot: (item.name if item else None)
                    for slot, item in self.player.equipped.items()
                }
            },
            "game_time_start": self.game_time_start.isoformat(),
            "quests": [
                {
                    "id": quest.id,
                    "progress": quest.progress,
                    "completed": quest.completed
                }
                for quest in self.player.quests + self.player.completed_quests
            ]
        }
        
        filename = f"save_{self.player.name}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
        
        try:
            with open(filename, 'w', encoding='utf-8') as f:
                json.dump(save_data, f, ensure_ascii=False, indent=2)
            print(f"تم حفظ اللعبة في {filename}")
        except Exception as e:
            print(f"خطأ في الحفظ: {e}")

    def load_game(self):
        # البحث عن ملفات الحفظ
        save_files = [f for f in os.listdir() if f.startswith('save_') and f.endswith('.json')]
        
        if not save_files:
            print("لا توجد ألعاب محفوظة!")
            return
        
        print("\nالألعاب المحفوظة:")
        for i, filename in enumerate(save_files, 1):
            print(f"{i}. {filename}")
        
        try:
            choice = int(input("\nاختر رقم الحفظ: ")) - 1
            if 0 <= choice < len(save_files):
                self.load_from_file(save_files[choice])
            else:
                print("اختيار غير صحيح!")
        except (ValueError, IndexError):
            print("الرجاء إدخال رقم صحيح!")

    def load_from_file(self, filename):
        try:
            with open(filename, 'r', encoding='utf-8') as f:
                save_data = json.load(f)
            
            # تحميل بيانات اللاعب
            player_data = save_data["player"]
            
            # إنشاء اللاعب
            class_map = {
                "المحارب": CharacterClass.WARRIOR,
                "الساحر": CharacterClass.MAGE,
                "الرامي": CharacterClass.ARCHER,
                "اللص": CharacterClass.ROGUE
            }
            
            self.player = Player(
                player_data["name"],
                class_map[player_data["character_class"]]
            )
            
            # تحديث خصائص اللاعب
            self.player.level = player_data["level"]
            self.player.exp = player_data["exp"]
            self.player.exp_to_next = player_data["exp_to_next"]
            self.player.hp = player_data["hp"]
            self.player.max_hp = player_data["max_hp"]
            self.player.mp = player_data["mp"]
            self.player.max_mp = player_data["max_mp"]
            self.player.gold = player_data["gold"]
            self.player.location = player_data["location"]
            self.player.kill_count = player_data["kill_count"]
            
            # تحميل المخزن
            self.player.inventory = []
            for item_data in player_data["inventory"]:
                item_type = ItemType(item_data["type"])
                item = Item(
                    item_data["name"],
                    item_type,
                    item_data["value"],
                    item_data["description"],
                    item_data["stats"]
                )
                self.player.inventory.append(item)
            
            # تحميل المعدات
            for slot, item_name in player_data["equipped"].items():
                if item_name:
                    for item in self.player.inventory:
                        if item.name == item_name and item.type.value in ["سلاح", "درع"]:
                            self.player.equipped[slot] = item
                            break
            
            # تحديث الإحصائيات
            self.player.attack = self.player.calculate_attack()
            self.player.defense = self.player.calculate_defense()
            
            # تحميل الوقت
            self.game_time_start = datetime.fromisoformat(save_data["game_time_start"])
            
            print(f"تم تحميل اللعبة بنجاح! مرحباً بعودتك {self.player.name}!")
            
        except Exception as e:
            print(f"خطأ في تحميل اللعبة: {e}")

    def update_play_time(self):
        if self.game_time_start:
            current_time = datetime.now()
            self.player.play_time = (current_time - self.game_time_start).seconds

    def quit_game(self):
        print("\nهل تريد حفظ اللعبة قبل الخروج؟ (نعم/لا)")
        choice = input("> ").lower()
        
        if choice in ["نعم", "ن", "y", "yes"]:
            self.save_game()
        
        print("\nشكراً للعب! إلى اللقاء!")
        self.game_running = False

