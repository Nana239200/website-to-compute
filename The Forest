# ============== الأنظمة الأساسية ==============

class ItemType(Enum):
    WEAPON = "سلاح"
    ARMOR = "درع"
    POTION = "جرعة"
    KEY = "مفتاح"
    TREASURE = "كنز"
    MATERIAL = "مادة"

class Item:
    def __init__(self, name, item_type, value, description, stats=None):
        self.name = name
        self.type = item_type
        self.value = value
        self.description = description
        self.stats = stats if stats else {}
    
    def __str__(self):
        return f"{self.name} ({self.type.value}): {self.description}"

class CharacterClass(Enum):
    WARRIOR = "المحارب"
    MAGE = "الساحر"
    ARCHER = "الرامي"
    ROGUE = "اللص"

class Player:
    def __init__(self, name, character_class):
        self.name = name
        self.character_class = character_class
        self.level = 1
        self.exp = 0
        self.exp_to_next = 100
        self.hp = self.max_hp = self.calculate_max_hp()
        self.mp = self.max_mp = self.calculate_max_mp()
        self.attack = self.calculate_attack()
        self.defense = self.calculate_defense()
        self.gold = 50
        self.inventory = []
        self.equipped = {"سلاح": None, "درع": None}
        self.location = "القرية"
        self.quests = []
        self.completed_quests = []
        self.kill_count = 0
        self.play_time = 0
        
        # إضافة العناصر الأساسية
        self.add_starting_items()
    
    def calculate_max_hp(self):
        base_hp = {
            CharacterClass.WARRIOR: 120,
            CharacterClass.MAGE: 80,
            CharacterClass.ARCHER: 90,
            CharacterClass.ROGUE: 85
        }
        return base_hp[self.character_class] + (self.level * 10)
    
    def calculate_max_mp(self):
        base_mp = {
            CharacterClass.WARRIOR: 30,
            CharacterClass.MAGE: 100,
            CharacterClass.ARCHER: 50,
            CharacterClass.ROGUE: 60
        }
        return base_mp[self.character_class] + (self.level * 5)
    
    def calculate_attack(self):
        base_attack = {
            CharacterClass.WARRIOR: 15,
            CharacterClass.MAGE: 8,
            CharacterClass.ARCHER: 12,
            CharacterClass.ROGUE: 10
        }
        attack = base_attack[self.character_class] + (self.level * 2)
        
        if self.equipped["سلاح"]:
            attack += self.equipped["سلاح"].stats.get("هجوم", 0)
        
        return attack
    
    def calculate_defense(self):
        base_defense = {
            CharacterClass.WARRIOR: 10,
            CharacterClass.MAGE: 4,
            CharacterClass.ARCHER: 6,
            CharacterClass.ROGUE: 5
        }
        defense = base_defense[self.character_class] + (self.level * 1)
        
        if self.equipped["درع"]:
            defense += self.equipped["درع"].stats.get("دفاع", 0)
        
        return defense
    
    def add_starting_items(self):
        starting_items = {
