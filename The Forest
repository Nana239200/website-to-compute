                self.use_item_menu()
            elif command == "المهام":
                self.show_quests()
            elif command == "محاربة":
                self.initiate_combat()
            elif command == "متجر":
                if self.player.location in ["القرية", "المتجر"]:
                    self.shop()
                else:
                    print("لا يوجد متجر هنا!")
            elif command == "مهمة":
                if self.player.location == "الصالة":
                    self.get_quest()
                else:
                    print("اذهب إلى الصالة للحصول على المهام.")
            elif command == "حفظ":
                self.save_game()
            elif command == "تحميل":
                self.load_game()
            elif command == "خروج":
                self.quit_game()
            elif command == "إحصائيات":
                self.show_statistics()
            elif command == "تصنيع":
                self.crafting_menu()
            elif command == "تحدث":
                self.talk_to_npc()
